{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "${workspaceFolder}/tasks/Build.sh",
      "windows": {
        "command": "${workspaceFolder}\\tasks\\Build.bat"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Publish",
      "type": "shell",
      "command": "${workspaceFolder}/tasks/Publish.sh",
      "windows": {
        "command": "${workspaceFolder}\\tasks\\Publish.bat"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Clean Publish",
      "type": "shell",
      "command": "${workspaceFolder}/tasks/CleanPublish.sh",
      "windows": {
        "command": "${workspaceFolder}\\tasks\\CleanPublish.bat"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "${workspaceFolder}/tasks/Clean.sh",
      "windows": {
        "command": "${workspaceFolder}\\tasks\\Clean.bat"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Launch",
      "type": "shell",
      "command": "${workspaceFolder}/tasks/Launch.sh",
      "windows": {
        "command": "${workspaceFolder}\\tasks\\Launch.bat"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": []
    }
  ]
}