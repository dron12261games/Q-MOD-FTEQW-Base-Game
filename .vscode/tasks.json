{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile only server",
      "type": "shell",
      "command": "${workspaceFolder}\\Compiler\\fteqcc64.exe",
      "args": [
        "-srcfile",
        "progs.src"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\base"
      },
      "isBackground": false,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Compile only client",
      "type": "shell",
      "command": "${workspaceFolder}\\Compiler\\fteqcc64.exe",
      "args": [
        "-srcfile",
        "csprogs.src"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\base"
      },
      "isBackground": false,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Compile",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\Compile.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Compile + Run",
      "type": "shell",
      "command": "${workspaceFolder}\\fteqw64.exe",
      "args": [
        "-game",
        "base"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": [],
      "group": "build",
      "dependsOn": [
        "Compile"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Compile + Run test map",
      "type": "shell",
      "command": "${workspaceFolder}\\fteqw64.exe",
      "args": [
        "-game",
        "base",
        "+map",
        "testmap"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": [],
      "group": "build",
      "dependsOn": [
        "Compile"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Clean build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\Clean build.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "${workspaceFolder}\\fteqw64.exe",
      "args": [
        "-game",
        "base"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Run test map",
      "type": "shell",
      "command": "${workspaceFolder}\\fteqw64.exe",
      "args": [
        "-game",
        "base",
        "+map",
        "testmap"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Run dedicated test server",
      "type": "shell",
      "command": "${workspaceFolder}\\fteqwsv64.exe",
      "args": [
        "-game",
        "base",
        "+map",
        "testmap"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": []
    }
  ]
}